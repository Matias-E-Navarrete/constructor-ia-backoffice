PORT=8080
DATABASE_URL=postgres://rimu:rimu@localhost:5432/rimu?sslmode=disable
JWT_SECRET=change-me-in-production
ADMIN_EMAILS=you@example.com
BACKEND_DIR=.
FRONTEND_DIR=../frontend

# Optional: without this, the assistant module stays enabled but replies with
# a clean "not configured" message instead of a real completion.
ANTHROPIC_API_KEY=

# Optional: without these, /api/me/upgrade stays a mock that flips the plan
# directly (no real charge). Set all three to enable real Stripe checkout.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://localhost:5173
